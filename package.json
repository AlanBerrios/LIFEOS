{
  "name": "lifeos",
  "version": "4.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:sync:native": "cmd /C \"set \"CI=1\" && npx expo prebuild --platform android\"",
    "android:sync:native:clean": "cmd /C \"set \"CI=1\" && npx expo prebuild --platform android --clean\"",
    "android:release:fast": "cmd /C \"set \"NODE_ENV=production\" && set \"CI=1\" && npx expo prebuild --platform android && cd android && gradlew.bat assembleRelease\"",
    "android:release:clean": "cmd /C \"set \"NODE_ENV=production\" && set \"CI=1\" && npx expo prebuild --platform android --clean && cd android && gradlew.bat --stop && gradlew.bat clean && gradlew.bat assembleRelease --console=plain --no-daemon\"",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:baseline": "npm run typecheck && npm run test",
    "qa:e2e:campaign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qa_e2e_campaign.ps1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "^5.0.1",
    "expo": "~54.0.36",
    "expo-background-fetch": "~14.0.9",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "lucide-react-native": "^1.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-wheel-color-picker": "^1.3.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  }
}
